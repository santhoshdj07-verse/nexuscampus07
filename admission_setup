<?php

session_start();

require_once "config/database.php";


/* =========================================================
   SMART CAMPUS
   COMPLETE ADMISSION SYSTEM DATABASE SETUP
   ========================================================= */


/* =========================================================
   1. STUDENT LOGIN TABLE
   ========================================================= */

$conn->query("
CREATE TABLE IF NOT EaXISTS student_accounts
(
    id INT AUTO_INCREMENT PRIMARY KEY,

    student_id INT NOT NULL UNIQUE,

    username VARCHAR(50) NOT NULL UNIQUE,

    password VARCHAR(255) NOT NULL,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (student_id)
    REFERENCES students(id)
    ON DELETE CASCADE
)
");


/* =========================================================
   2. APPLICATIONS
   ========================================================= */

$conn->query("
CREATE TABLE IF NOT EXISTS student_applications
(
    id INT AUTO_INCREMENT PRIMARY KEY,

    application_no VARCHAR(30) NOT NULL UNIQUE,

    student_id INT NOT NULL,

    course_type ENUM('UG','PG') NOT NULL,

    course_name VARCHAR(100) NOT NULL,

    date_of_birth DATE NULL,

    gender VARCHAR(20),

    email VARCHAR(100),

    address TEXT,

    tenth_school VARCHAR(150),

    tenth_year VARCHAR(10),

    tenth_percentage DECIMAL(5,2),

    eleventh_school VARCHAR(150),

    eleventh_year VARCHAR(10),

    eleventh_percentage DECIMAL(5,2),

    twelfth_school VARCHAR(150),

    twelfth_year VARCHAR(10),

    twelfth_percentage DECIMAL(5,2),

    ug_college VARCHAR(150),

    ug_course VARCHAR(100),

    ug_university VARCHAR(150),

    ug_year VARCHAR(10),

    ug_percentage DECIMAL(5,2),

    application_status
        ENUM(
            'DRAFT',
            'SUBMITTED',
            'ACCEPTED',
            'REJECTED'
        )
        DEFAULT 'DRAFT',

    rejection_reason TEXT,

    submitted_at DATETIME NULL,

    reviewed_at DATETIME NULL,

    reviewed_by INT NULL,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    updated_at TIMESTAMP
        DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    FOREIGN KEY (student_id)
        REFERENCES students(id)
        ON DELETE CASCADE
)
");


/* =========================================================
   3. DOCUMENTS
   ========================================================= */

$conn->query("
CREATE TABLE IF NOT EXISTS application_documents
(
    id INT AUTO_INCREMENT PRIMARY KEY,

    application_id INT NOT NULL,

    document_type VARCHAR(100) NOT NULL,

    file_name VARCHAR(255) NOT NULL,

    file_path VARCHAR(500) NOT NULL,

    file_size INT DEFAULT 0,

    mime_type VARCHAR(100),

    document_status
        ENUM(
            'UPLOADED',
            'VERIFIED',
            'REJECTED'
        )
        DEFAULT 'UPLOADED',

    verification_note TEXT,

    verified_by INT NULL,

    verified_at DATETIME NULL,

    uploaded_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (application_id)
        REFERENCES student_applications(id)
        ON DELETE CASCADE
)
");


/* =========================================================
   4. ADMISSION
   ========================================================= */

$conn->query("
CREATE TABLE IF NOT EXISTS admission_applications
(
    id INT AUTO_INCREMENT PRIMARY KEY,

    admission_no VARCHAR(40) UNIQUE,

    application_id INT NOT NULL UNIQUE,

    student_id INT NOT NULL,

    admission_status
        ENUM(
            'DOCUMENT_VERIFICATION',
            'VERIFICATION_DONE',
            'PROCESSING',
            'APPROVED',
            'REJECTED'
        )
        DEFAULT 'DOCUMENT_VERIFICATION',

    admission_remarks TEXT,

    approved_by INT NULL,

    approved_at DATETIME NULL,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    updated_at TIMESTAMP
        DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    FOREIGN KEY (application_id)
        REFERENCES student_applications(id)
        ON DELETE CASCADE,

    FOREIGN KEY (student_id)
        REFERENCES students(id)
        ON DELETE CASCADE
)
");


/* =========================================================
   5. STATUS HISTORY
   ========================================================= */

$conn->query("
CREATE TABLE IF NOT EXISTS admission_status_history
(
    id INT AUTO_INCREMENT PRIMARY KEY,

    student_id INT NOT NULL,

    application_id INT NULL,

    status VARCHAR(100) NOT NULL,

    remarks TEXT,

    changed_by INT NULL,

    changed_by_type VARCHAR(20),

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (student_id)
        REFERENCES students(id)
        ON DELETE CASCADE
)
");


/* =========================================================
   6. NOTIFICATIONS
   ========================================================= */

$conn->query("
CREATE TABLE IF NOT EXISTS notifications
(
    id INT AUTO_INCREMENT PRIMARY KEY,

    user_id INT NOT NULL,

    user_type ENUM('STUDENT','ADMIN') NOT NULL,

    title VARCHAR(200) NOT NULL,

    message TEXT NOT NULL,

    notification_type VARCHAR(50),

    is_read TINYINT(1) DEFAULT 0,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
)
");


/* =========================================================
   7. CREATE UPLOAD DIRECTORY
   ========================================================= */

$uploadDirectory =
    __DIR__ .
    DIRECTORY_SEPARATOR .
    "uploads" .
    DIRECTORY_SEPARATOR .
    "documents";


if (!is_dir($uploadDirectory))
{
    mkdir(
        $uploadDirectory,
        0777,
        true
    );
}


